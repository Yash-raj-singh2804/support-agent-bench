# API keys: set at least one. Models are "provider:model" specs.
ANTHROPIC_API_KEY=
# Open-weight models (gpt-oss, Qwen, Llama) via https://console.groq.com
GROQ_API_KEY=
# Sarvam Token Factory (DeepSeek V4.1 Flash, GLM 5.3 Flash, Gemma 4): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Optional: none | low | medium | high (default: each model's own setting; GLM can't turn thinking off)
# SARVAM_REASONING_EFFORT=
# Sarvam prices are in INR; costs are shown in USD using this rate
INR_PER_USD=94
# Google Gemini via https://aistudio.google.com/apikey (GOOGLE_API_KEY also works)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter, ...)
# OPENAI_BASE_URL=

# Defaults; the UI lets you pick per batch / experiment.
AGENT_MODEL=anthropic:claude-sonnet-5-5
USER_MODEL=anthropic:claude-sonnet-5-5
JUDGE_MODEL=anthropic:claude-sonnet-5-5
# e.g. a fully open-weight setup:
# AGENT_MODEL=sarvam:deepseekv4.1-flash-1017
# AGENT_MODEL=gemini:gemini-3.5-flash
# AGENT_MODEL=groq:openai/gpt-oss-120b
# USER_MODEL=groq:openai/gpt-oss-120b
# JUDGE_MODEL=groq:openai/gpt-oss-120b

# Run the LLM failure-analysis judge automatically after each failed episode
AUTO_ANALYZE=true

# Fail episodes that reach the gold state but broke process (a write without authentication, on another customer's
# order, or without explicit confirmation). false = outcome-only scoring, as in older results.
SCORE_PROCESS=true

# Sampling temperature (OpenAI/Groq only; Claude ignores it). Use "none" to omit.
AGENT_TEMPERATURE=0
USER_TEMPERATURE=0.7

MAX_CONCURRENCY=4

# Rate limiting (0 = off). Requests are paced per model so free tiers don't return HTTP 429.
# Groq free tier is about 30 requests/min, 8K tokens/min and 200K tokens/day per model:
GROQ_RPM=30
GROQ_TPM=8000
GROQ_MAX_CONCURRENCY=1
# Gemini free tier (check https://aistudio.google.com/rate-limit for your model):
# GEMINI_RPM=10
# GEMINI_TPM=250000
# Give up on a single call after waiting this long (seconds)
RATE_LIMIT_MAX_WAIT_S=600
MAX_USER_TURNS=30
